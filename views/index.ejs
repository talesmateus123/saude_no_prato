<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f7f4ee">
    <title><%= titulo %> | Alimentação escolar</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/meals.css">
    <link rel="stylesheet" href="/css/logout.css">
    <link rel="stylesheet" href="/css/portions.css">
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-mark">✦</span><span>prato <strong>vivo</strong></span></a>
        <div class="profile"><div class="avatar">MC</div><div><strong>Marina Costa</strong><small>Nutrição escolar</small></div><span class="status-dot"></span></div>
        <nav class="nav" aria-label="Navegação principal">
            <a class="nav-link active" href="#inicio" data-section="inicio"><span>◈</span> Visão geral</a>
            <a class="nav-link" href="#cardapio" data-section="cardapio"><span>▦</span> Cardápio</a>
            <a class="nav-link" href="#porcoes" data-section="porcoes"><span>◒</span> Porções</a>
            <a class="nav-link" href="#alunos" data-section="alunos"><span>♧</span> Alunos</a>
            <a class="nav-link" href="#relatorios" data-section="relatorios"><span>▤</span> Relatórios</a>
        </nav>
        <div class="sidebar-bottom"><p>Prato Vivo <span>v1.0</span></p></div>
    </aside>
    <main class="main-content">
        <header class="topbar"><button class="menu-toggle" aria-label="Abrir menu">☰</button><div class="crumb">CARDÁPIO E ALIMENTAÇÃO ESCOLAR</div><div class="top-actions"><button class="icon-button" title="Notificações" id="notification-button">♢<span class="notification-dot"></span></button><div class="user-menu"><button class="user-button" id="user-menu-toggle" type="button" aria-expanded="false" aria-controls="user-menu"><span class="avatar small">MC</span><span>Marina Costa</span><span aria-hidden="true">⌄</span></button><div class="user-menu-popover" id="user-menu" hidden><form action="/logout" method="post"><button class="user-logout-button" type="submit"><span aria-hidden="true">↪</span> Sair</button></form></div></div></div></header>
        <div class="content-wrap">
            <section id="porcoes" class="page-section">
                <div class="section-title"><div><p class="eyebrow">CONTROLE DE REFEIÇÕES</p><h1>Porções do dia</h1><p>Registre o que foi preparado e servido em cada refeição.</p></div></div>
                <form id="prepared-meals-form" class="panel portions-form"><div class="panel-heading"><div><p class="eyebrow">PRODUÇÃO DE HOJE</p><h2>Porções preparadas</h2></div></div><div class="portions-grid"><label>Café da manhã<input name="cafe-da-manha" type="number" min="0" step="1" inputmode="numeric" required></label><label>Almoço<input name="almoco" type="number" min="0" step="1" inputmode="numeric" required></label><label>Jantar<input name="jantar" type="number" min="0" step="1" inputmode="numeric" required></label></div><div class="portions-footer"><p id="prepared-meals-feedback" class="feedback" aria-live="polite"></p><button class="primary-button" type="submit">Salvar porções preparadas</button></div></form>
                <form id="served-meals-form" class="panel portions-form"><div class="panel-heading"><div><p class="eyebrow">REGISTRO DE HOJE</p><h2>Porções servidas</h2></div></div><div class="portions-grid"><label>Café da manhã<input name="cafe-da-manha" type="number" min="0" step="1" inputmode="numeric" required></label><label>Almoço<input name="almoco" type="number" min="0" step="1" inputmode="numeric" required></label><label>Jantar<input name="jantar" type="number" min="0" step="1" inputmode="numeric" required></label></div><div class="portions-footer"><p id="served-meals-feedback" class="feedback" aria-live="polite"></p><button class="primary-button" type="submit">Salvar porções servidas</button></div></form>
            </section>
            <section id="inicio" class="page-section active-section">
                <div class="welcome"><div><p class="eyebrow">BOM DIA, MARINA</p><h1>Alimentar bem é<br><em>cuidar do futuro.</em></h1><p class="subheading">Acompanhe hoje a alimentação da sua escola.</p></div><div class="date-card"><span>HOJE</span><strong>16</strong><small>SET · QUARTA</small></div></div>
                <div class="metric-grid"><article class="metric-card coral"><span class="metric-icon">♧</span><small>ALUNOS ATIVOS</small><strong id="students-count">--</strong><p>na escola hoje</p></article><article class="metric-card yellow"><span class="metric-icon">✓</span><small>PRESENÇAS HOJE</small><strong id="present-count">--</strong><p><b class="up">↑ 8%</b> vs. ontem</p></article><article class="metric-card mint"><span class="metric-icon">◒</span><small>REFEIÇÕES SERVIDAS</small><strong id="consumed-count">--</strong><p>de <span id="prepared-count">--</span> preparadas</p></article></div>
                <section class="panel today-menu"><div class="panel-heading"><div><p class="eyebrow">CARDÁPIO DO DIA</p><h2>As três refeições de hoje</h2></div></div><div id="today-menu-list" class="today-menu-list"></div></section>
                <div class="dashboard-grid"><section class="panel menu-preview"><div class="panel-heading"><div><p class="eyebrow">PRÓXIMOS DIAS</p><h2>Cardápio da semana</h2></div><a href="#cardapio" class="text-link" data-section="cardapio">Ver completo <span>→</span></a></div><div id="menu-list" class="menu-list"></div></section><section class="panel notifications"><div class="panel-heading"><div><p class="eyebrow">CENTRAL DE AVISOS</p><h2>Notificações</h2></div><span class="count-badge">2 novas</span></div><div id="notification-list" class="notification-list"></div></section></div>
            </section>
            <section id="cardapio" class="page-section"><div class="section-title"><div><p class="eyebrow">PLANEJAMENTO NUTRICIONAL</p><h1>Cardápio</h1><p>Planeje café da manhã, almoço e jantar para os cinco dias úteis.</p></div></div><form id="weekly-menu-form" class="panel weekly-menu-form"><div class="week-form-heading"><div><p class="eyebrow">EDIÇÃO DA SEMANA</p><h2>Cardápio e alérgenos por refeição</h2></div><label>Segunda-feira da semana<input type="date" id="week-start" required></label></div><div id="weekly-menu-days" class="weekly-menu-days"></div><div class="week-form-footer"><p id="weekly-menu-feedback" class="feedback" aria-live="polite"></p><button class="primary-button" type="submit">Publicar cardápio semanal</button></div></form><div class="panel menu-table-panel"><div class="filter-row"><span class="legend"><i class="published"></i> Publicado</span></div><div id="full-menu-list" class="full-menu-list"></div></div></section>
            <section id="alunos" class="page-section"><div class="section-title"><div><p class="eyebrow">COMUNIDADE ESCOLAR</p><h1>Alunos e restrições</h1><p>Cadastre os dados pessoais e acompanhe o status de cada aluno.</p></div><button id="toggle-student-form" class="primary-button" type="button" aria-expanded="false" aria-controls="student-form">+ Novo cadastro</button></div><form id="student-form" class="panel student-form" hidden><div class="student-form-heading"><div><p class="eyebrow">NOVO CADASTRO</p><h2>Dados do aluno</h2></div><span class="required-note">* campos obrigatórios</span></div><div class="student-form-grid"><label>Nome completo *<input name="name" required></label><label>Matrícula *<input name="enrollment" inputmode="numeric" required></label><label>Turma ou série *<input name="className" placeholder="Ex.: 5º ano A" required></label><label>Data de nascimento<input name="birthDate" type="date"></label><label>Sexo<input name="gender" placeholder="Opcional"></label><label>Status *<select name="status"><option value="ativo">Ativo</option><option value="inativo">Inativo</option><option value="transferido">Transferido</option></select></label><label>Responsável<input name="guardianName"></label><label>Telefone do responsável<input name="guardianPhone" type="tel"></label><label class="student-form-wide">Endereço<input name="address"></label><label class="student-form-wide">Restrições alimentares<input name="restrictions" placeholder="Ex.: lactose, ovo, amendoim"></label></div><div class="student-form-footer"><p id="student-form-feedback" class="feedback" aria-live="polite"></p><button class="secondary-button" id="cancel-student-button" type="button">Limpar</button><button class="primary-button" type="submit">Cadastrar aluno</button></div></form><div class="panel students-panel"><div class="search-row"><input id="student-search" placeholder="⌕  Buscar por nome ou matrícula"><span id="student-total"></span><button id="remove-students-button" class="danger-button" type="button" disabled>Remover selecionados</button></div><div id="students-list" class="students-list"></div></div></section>
            <section id="relatorios" class="page-section"><div class="section-title"><div><p class="eyebrow">ACOMPANHAMENTO</p><h1>Relatórios</h1><p>Dados que ajudam a planejar melhor cada refeição.</p></div><button class="secondary-button" id="export-button">↓ Exportar dados</button></div><div class="report-grid"><div class="panel report-card"><small>REFEIÇÕES PREPARADAS</small><strong id="report-prepared">--</strong><div class="progress"><span id="prepared-progress"></span></div><p>Meta diária de 140 refeições</p></div><div class="panel report-card"><small>CONSUMO REAL</small><strong id="report-consumed">--</strong><div class="progress mint-progress"><span id="consumed-progress"></span></div><p>Taxa de aproveitamento <b id="consumption-rate">--%</b></p></div><div class="panel report-card wide"><small>PRESENÇA POR TURMA</small><div id="class-report" class="class-report"></div></div></div></section>
        </div>
    </main>
</div>
<div id="toast" class="toast" role="status"></div>
<script src="/js/app.js"></script>
</body>
</html>
